{
  "name": "GhostWriter",
  "short_name": "GhostWriter",
  "description": "A private, local-first writing studio with templates, automatic saving, backups, and portable exports.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0d0b1a",
  "theme_color": "#0d0b1a",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/ghostwriter-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    },
    {
      "src": "/ghostwriter-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
