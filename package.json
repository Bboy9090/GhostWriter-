{
  "name": "ghost-writer",
  "private": true,
  "version": "1.1.0-family.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:check": "tsc --noEmit",
    "lint": "eslint src/App.tsx src/main.tsx src/lib/project-storage.ts src/lib/export.ts src/lib/templates.ts src/components/ui/button.tsx src/components/ui/card.tsx src/components/ui/input.tsx src/components/ui/textarea.tsx src/components/ui/badge.tsx src/lib/utils.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "analyze": "ANALYZE=true vite build",
    "check-all": "npm run type-check && npm run lint && npm test -- --run && npm run build",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.11",
    "terser": "^5.46.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  },
  "description": "Local-first writing and publishing studio for Bobby's World / Blue Phoenix OS",
  "author": "Bobby's World",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bboy9090/GhostWriter-.git"
  },
  "keywords": [
    "writing",
    "editor",
    "productivity",
    "publishing",
    "markdown",
    "templates",
    "local-first",
    "pwa"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
